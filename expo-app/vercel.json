{
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "env": {
    "SENTRY_DISABLE_AUTO_UPLOAD": "true",
    "NODE_OPTIONS": "--max-old-space-size=8192"
  },
  "redirects": [
    { "source": "/app/.env", "statusCode": 404, "destination": "/404.html" },
    { "source": "/app/.env.local", "statusCode": 404, "destination": "/404.html" },
    { "source": "/app/.env.production", "statusCode": 404, "destination": "/404.html" },
    { "source": "/app/.git/:path*", "statusCode": 404, "destination": "/404.html" },
    { "source": "/app/.:path*", "statusCode": 404, "destination": "/404.html" }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy.html" },
    { "source": "/cookies", "destination": "/cookie-policy.html" },
    { "source": "/athlete-agreement", "destination": "/athlete-agreement.html" },
    { "source": "/help-center", "destination": "/help-center.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/contact-team", "destination": "/contact-team.html" },
    { "source": "/contact-assistant", "destination": "/contact-assistant.html" },
    { "source": "/live-chat", "destination": "/live-chat.html" },
    { "source": "/how", "destination": "/how.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/impact", "destination": "/impact.html" },
    { "source": "/labels-and-markings", "destination": "/labels-and-markings.html" },
    { "source": "/email-confirmed", "destination": "/email-confirmed.html" },
    { "source": "/password-reset", "destination": "/password-reset.html" },
    { "source": "/demo", "destination": "/app/index.html" },
    { "source": "/demo/:path*", "destination": "/app/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/auth/callback", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://api.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://api.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://api.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/app/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://api.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
