{
  "expo": {
    "name": "Dalton Demo",
    "slug": "dalton-demo",
    "scheme": "dalton-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dalton_logo_final_img-icons/iOS/Icon-1024.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/dalton_logo_final_img.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hc111.daltondemo",
      "icon": "./assets/dalton_logo_final_img-icons/iOS/Icon-76@2x.png",
      "splash": {
        "image": "./assets/dalton_logo_final_img.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "rive.app": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "android": {
      "package": "com.hc111.daltondemo",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/dalton_logo_final_img-icons/Android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./assets/dalton_logo_final_img-icons/Android/mipmap-xxxhdpi/ic_launcher_foreground.png"
      },
      "splash": {
        "image": "./assets/dalton_logo_final_img.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/dalton_logo_final_img-icons/Web/favicon-48x48.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dalton to access your photos and videos for uploads.",
          "cameraPermission": "Allow Dalton to use your camera for uploads."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/dalton_logo_final_img.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/dalton_logo_final_img.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8b3d97c5-6276-49b3-ab55-aa9b87e47047"
      }
    },
    "owner": "hc111"
  }
}
