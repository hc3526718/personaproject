# Copy to .env (not committed). Expo loads EXPO_PUBLIC_* at build time.

# --- Supabase (Postgres + Auth + Storage) — chosen default stack ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: demo remains available when URL/key are empty ---
# EXPO_PUBLIC_FORCE_DEMO_AUTH=1

# --- RevenueCat (development / App Store builds; skipped in Expo Go) ---
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# --- Backend API (your Edge Functions / custom server) ---
EXPO_PUBLIC_API_BASE_URL=

# --- Ticket QR signing (must match server HMAC secret in production) ---
EXPO_PUBLIC_TICKET_SIGNING_SECRET=demo-only-change-in-production

# --- Sentry (optional; errors + boot/Rive diagnostics) ---
# EXPO_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# EAS: eas.json sets SENTRY_DISABLE_AUTO_UPLOAD=true so Xcode does not require SENTRY_ORG during build.
# Local Xcode: if sentry-cli fails, set SENTRY_DISABLE_AUTO_UPLOAD=true or add org/project to env.

# --- Boot Rive (optional) ---
# EXPO_PUBLIC_BOOT_USE_RIVE=0
# Dev client / EAS: default = bundled dalton_animated_logo.riv (native). No rive.app WebView unless:
# EXPO_PUBLIC_RIVE_USE_CLOUD_EMBED=1
# EXPO_PUBLIC_RIVE_EMBED_URL=https://rive.app/s/.../embed?runtime=rive-renderer
# EXPO_PUBLIC_RIVE_DISABLE_EMBED=1  (Expo Go: bounce only; dev builds: still uses bundled native unless cloud embed on)
# EXPO_PUBLIC_RIVE_URL=https://.../file.riv  (hosted .riv via native player)
# Cloud embed logo scale in WebView (1.25–5.5). Default 3.5.
# EXPO_PUBLIC_RIVE_EMBED_SCALE=3.5
